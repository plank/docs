1.9202ZM16.9722 12.2306C15.052 12.2306 12.9042 12.3133 11.0226 11.9202L10.7743 13.1086C12.8133 13.5346 15.1333 13.4446 16.9722 13.4446V12.2306ZM11.0225 11.9202C10.0363 11.7142 8.91061 12.174 8.51996 13.2157L9.65669 13.642C9.80114 13.2568 10.2688 13.003 10.7743 13.1086L11.0225 11.9202ZM8.51995 13.2157C8.14345 14.2199 8.63711 15.4462 9.80201 15.6948L10.0554 14.5075C9.73 14.4381 9.49812 14.0649 9.6567 13.642L8.51995 13.2157ZM9.80193 15.6948C11.1939 15.9921 12.6735 16.0492 13.9817 16.1224L14.0495 14.9102C12.7022 14.8349 11.3338 14.7806 10.0555 14.5076L9.80193 15.6948ZM13.4086 15.5163V18.8217H14.6226V15.5163H13.4086ZM13.4086 18.8217C13.4086 18.9473 13.4192 19.071 13.4399 19.1917L14.6365 18.9868C14.6274 18.9337 14.6226 18.8785 14.6226 18.8217H13.4086ZM13.4446 18.9624L12.5008 23.3773L13.688 23.6311L14.6318 19.2161L13.4446 18.9624ZM12.5008 23.3773C12.2408 24.5938 13.1682 25.7406 14.4123 25.7406V24.5266C13.941 24.5266 13.5895 24.092 13.688 23.6311L12.5008 23.3773ZM14.4123 25.7406C15.3352 25.7406 16.1323 25.095 16.3242 24.1923L15.1367 23.9399C15.064 24.2819 14.7619 24.5266 14.4123 24.5266V25.7406ZM16.3242 24.1924L17.1039 20.5246L15.9164 20.2721L15.1367 23.9399L16.3242 24.1924ZM16.5102 21.0054H17.434V19.7913H16.5102V21.0054ZM16.8402 20.5246L17.62 24.1924L18.8075 23.9399L18.0277 20.2721L16.8402 20.5246ZM17.62 24.1923C17.8118 25.095 18.609 25.7406 19.5319 25.7406V24.5266C19.1822 24.5266 18.8802 24.2819 18.8075 23.9399L17.62 24.1923ZM19.5319 25.7406C20.776 25.7406 21.7034 24.5938 21.4433 23.3773L20.2561 23.6311C20.3547 24.0921 20.0032 24.5266 19.5319 24.5266V25.7406ZM21.4433 23.3773L20.4994 18.9621L19.3122 19.2159L20.2561 23.6311L21.4433 23.3773ZM20.5041 19.1915C20.5249 19.0706 20.5354 18.9469 20.5354 18.8217H19.3214C19.3214 18.8786 19.3166 18.9337 19.3075 18.9865L20.5041 19.1915Z"
			></path>
		</svg>
	</button>
	<div class="pm-menu" id={id} hidden>
		<fieldset class="pm-group">
			<legend class="pm-heading">Theme</legend>
			<div class="pm-seg">
				<label><input type="radio" name={`${id}-theme`} value="light" /><Icon name="sun" size="1rem" />Light</label>
				<label><input type="radio" name={`${id}-theme`} value="dark" /><Icon name="moon" size="1rem" />Dark</label>
			</div>
		</fieldset>
		<div class="pm-group">
			<p class="pm-heading">Motion</p>
			<div class="pm-row">
				<span id={`${id}-rm`}>Reduced motion</span>
				<span class="pm-status" aria-hidden="true">off</span>
				<button
					type="button"
					class="pm-switch"
					role="switch"
					aria-checked="false"
					aria-labelledby={`${id}-rm`}
					aria-describedby={`${id}-note`}
				>
					<svg viewBox="0 0 40 19" aria-hidden="true">
						<rect class="pm-track" x="0.5" y="0.5" width="39" height="18" rx="9"></rect>
						<circle class="pm-knob" cx="11.5" cy="9.5" r="7.5"></circle>
					</svg>
				</button>
			</div>
			<p class="pm-note" id={`${id}-note`} hidden>Your system asks for reduced motion.</p>
		</div>
	</div>
</div>

<script>
	const html = document.documentElement;
	const menus = [...document.querySelectorAll<HTMLElement>('.pm')];
	const plankMotion = () => (window as unknown as { plankMotion: () => void }).plankMotion();
	const siteSetting = () => {
		try {
			return localStorage.getItem('plank-reduce-motion') === 'true';
		} catch {
			return false;
		}
	};
	const sync = () =>
		menus.forEach((m) => {
			const theme = html.dataset.theme === 'light' ? 'light' : 'dark';
			m.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((r) => (r.checked = r.value === theme));
			const os = html.dataset.rmWhy === 'os';
			const on = os || siteSetting();
			const toggle = m.querySelector<HTMLButtonElement>('.pm-switch')!;
			toggle.setAttribute('aria-checked', String(on));
			toggle.disabled = os;
			m.querySelector('.pm-status')!.textContent = on ? 'on' : 'off';
			m.querySelector<HTMLElement>('.pm-note')!.hidden = !os;
		});

	menus.forEach((m) => {
		// The header imports this component directly and the menu drawer reaches it through Starlight's
		// ThemeSelect override, so this script can arrive twice. Bind each menu once.
		if (m.dataset.bound) return;
		m.dataset.bound = 'true';
		const trigger = m.querySelector<HTMLButtonElement>('.pm-trigger')!;
		const menu = m.querySelector<HTMLElement>('.pm-menu')!;
		const setOpen = (open: boolean) => {
			trigger.setAttribute('aria-expanded', String(open));
			menu.hidden = !open;
			menu.classList.toggle('is-entering', open && html.dataset.rm === 'ok');
		};
		menu.addEventListener('animationend', () => menu.classList.remove('is-entering'));
		trigger.addEventListener('click', () => setOpen(menu.hidden));
		document.addEventListener('click', (e) => {
			if (!menu.hidden && !m.contains(e.target as Node)) setOpen(false);
		});
		m.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !menu.hidden) {
				setOpen(false);
				trigger.focus();
			}
		});
		m.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((r) =>
			r.addEventListener('change', () => {
				html.dataset.theme = r.value;
				try {
					localStorage.setItem('starlight-theme', r.value);
				} catch {}
				sync();
			}),
		);
		m.querySelector('.pm-switch')!.addEventListener('click', () => {
			try {
				localStorage.setItem('plank-reduce-motion', String(!siteSetting()));
			} catch {}
			plankMotion();
		});
	});

	// Until a reader picks a theme, follow the system's, as Starlight does.
	const light = matchMedia('(prefers-color-scheme: light)');
	light.addEventListener('change', () => {
		let stored = '';
		try {
			stored = localStorage.getItem('starlight-theme') || '';
		} catch {}
		if (!stored) {
			html.dataset.theme = light.matches ? 'light' : 'dark';
			sync();
		}
	});
	document.addEventListener('proto:motion', sync);
	sync();
</script>

<style>
	.pm {
		position: relative;
		display: flex;
	}
	.pm-trigger {
		all: unset;
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 50%;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.pm-trigger:hover,
	.pm-trigger[aria-expanded='true'] {
		background: var(--sl-color-gray-6);
	}
	.pm-trigger:focus-visible {
		outline: 2px solid var(--plank-teal);
		outline-offset: 2px;
	}
	.pm-trigger svg {
		width: 28px;
		height: 26px;
	}

	.pm-menu {
		position: absolute;
		z-index: 20;
		top: calc(100% + 0.6rem);
		right: 0;
		width: 15rem;
		box-sizing: border-box;
		padding: 1rem 1.1rem 1.1rem;
		border-radius: var(--radius);
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		box-shadow: 0 12px 32px rgb(0 0 0 / 0.2);
	}
	:global(:root[data-theme='light']) .pm-menu {
		background: var(--plank-sand);
		box-shadow: 0 12px 32px rgb(17 38 33 / 0.14);
	}
	.pm-menu[hidden] {
		display: none;
	}
	/* In the phone menu drawer's footer, open upwards. */
	:global(.mobile-preferences) .pm-menu {
		top: auto;
		bottom: calc(100% + 0.6rem);
	}
	:global(html[data-rm='ok']) .pm-menu.is-entering {
		animation: pm-in 0.2s var(--ease-out) both;
	}
	@keyframes pm-in {
		from {
			opacity: 0;
			translate: 0 -0.35rem;
		}
	}

	.pm-group {
		margin: 0;
		padding: 0;
		border: 0;
		min-inline-size: 0;
	}
	.pm-group + .pm-group {
		margin-top: 1.1rem;
	}
	.pm-heading {
		float: left;
		width: 100%;
		margin: 0 0 0.55rem;
		padding: 0;
		font: 600 0.7rem/1.3 var(--font-body);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.pm-seg {
		clear: both;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.15rem;
		padding: 0.2rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--radius);
	}
	.pm-seg label {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		padding: 0.3rem 0.5rem;
		border-radius: 7px;
		font: 500 0.85rem/1.4 var(--font-body);
		color: var(--sl-color-gray-3);
		cursor: pointer;
	}
	.pm-seg label:hover {
		color: var(--sl-color-white);
	}
	.pm-seg label:has(input:checked) {
		background: var(--plank-coral);
		color: var(--plank-ink);
	}
	.pm-seg label:has(input:focus-visible) {
		outline: 2px solid var(--plank-teal);
		outline-offset: 2px;
	}
	.pm-seg input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
		margin: 0;
	}

	/* plank.co's switch row: an uppercase label, its status, then the switch. */
	.pm-row {
		clear: both;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font: 500 0.75rem/1.3 var(--font-body);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.pm-status {
		margin-right: auto;
	}
	.pm-switch {
		all: unset;
		display: flex;
		border-radius: 999px;
		cursor: pointer;
	}
	.pm-switch:focus-visible {
		outline: 2px solid var(--plank-teal);
		outline-offset: 3px;
	}
	.pm-switch:disabled {
		cursor: not-allowed;
		opacity: 0.7;
	}
	.pm-switch svg {
		width: 40px;
		height: 19px;
		overflow: visible;
	}
	.pm-track {
		fill: transparent;
		stroke: var(--sl-color-white);
	}
	.pm-knob {
		fill: var(--plank-coral);
	}
	.pm-switch[aria-checked='true'] .pm-track {
		fill: var(--sl-color-white);
	}
	.pm-switch[aria-checked='true'] .pm-knob {
		translate: 18px 0;
	}
	:global(html[data-rm='ok']) .pm-knob {
		transition: translate 0.2s var(--ease-out);
	}
	.pm-note {
		margin: 0.6rem 0 0;
		font: 0.8rem/1.4 var(--font-body);
		color: var(--sl-color-gray-3);
	}
</style>
