---
// PROTOTYPE (motion variant C only): plank.co's reduced-motion toggle, redone for the Docs Site.
// Like plank.co's, it can only reduce: when the OS already asks for reduced motion, that wins.
// It's kept in localStorage, which every Docs Version shares because the router serves them all
// from one origin (ADR 0003). plank.co keeps it in a cookie and reloads the page; this applies at once.
---

<button type="button" class="pm-toggle" data-m="C" aria-pressed="false">Reduce motion</button>

<script>
	const toggles = document.querySelectorAll<HTMLButtonElement>('.pm-toggle');
	const siteSetting = () => {
		try {
			return localStorage.getItem('plank-reduce-motion') === 'true';
		} catch {
			return false;
		}
	};
	const sync = () => {
		const os = document.documentElement.dataset.rmWhy === 'os';
		toggles.forEach((b) => {
			b.setAttribute('aria-pressed', String(os || siteSetting()));
			b.disabled = os;
			b.title = os ? 'Your system already asks for reduced motion' : '';
		});
	};
	toggles.forEach((b) =>
		b.addEventListener('click', () => {
			try {
				localStorage.setItem('plank-reduce-motion', String(!siteSetting()));
			} catch {}
			(window as unknown as { plankMotion: () => void }).plankMotion();
		}),
	);
	document.addEventListener('proto:motion', sync);
	sync();
</script>
