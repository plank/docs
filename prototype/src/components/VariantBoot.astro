---
// PROTOTYPE for plank/docs#25: picks the code-block variant before first paint. ?variant= is the source of
// truth; sessionStorage carries it across links that drop it, and the URL is rewritten so it stays shareable.
// The layouts are fixed to the ones chosen in plank/docs#7 (landing page B, doc page A), and dark is Ink (plank/docs#19).
---

<script is:inline>
	(() => {
		const root = document.documentElement;
		root.dataset.layout = location.pathname === '/' ? 'B' : 'A';
		const keys = ['A', 'B', 'C'];
		const url = new URL(location.href);
		let v = (url.searchParams.get('variant') || '').toUpperCase();
		if (!keys.includes(v)) {
			try { v = sessionStorage.getItem('proto-code') || ''; } catch {}
		}
		if (!keys.includes(v)) v = 'A';
		root.dataset.variant = v;
		try { sessionStorage.setItem('proto-code', v); } catch {}
		if (url.searchParams.get('variant') !== v) {
			url.searchParams.set('variant', v);
			history.replaceState(null, '', url);
		}
	})();
</script>
