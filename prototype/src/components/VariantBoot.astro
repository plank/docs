---
// PROTOTYPE for plank/docs#22, run before first paint.
// - The design is settled by plank/docs#7 (landing B, doc page A), so data-variant is fixed.
// - ?variant=A|B|C picks the motion variant (data-motion). The URL is the source of truth;
//   sessionStorage carries it across links, and the URL is rewritten so it stays shareable.
// - plankMotion() works out data-rm ("ok" or "reduce") from the OS setting, or the bar's simulation
//   of it, and from the site's own setting (A11yFloat on the landing page, A11yMenu on doc pages).
//   Everything in motion.css keys off these. The User chose C, so it's the default.
---

<script is:inline>
	(() => {
		const root = document.documentElement;
		const keys = ['A', 'B', 'C'];
		const url = new URL(location.href);
		let v = (url.searchParams.get('variant') || '').toUpperCase();
		if (!keys.includes(v)) {
			try { v = sessionStorage.getItem('proto-motion') || ''; } catch {}
		}
		if (!keys.includes(v)) v = 'C';
		root.dataset.motion = v;
		root.dataset.variant = location.pathname === '/' ? 'B' : 'A';
		try { sessionStorage.setItem('proto-motion', v); } catch {}
		if (url.searchParams.get('variant') !== v) {
			url.searchParams.set('variant', v);
			history.replaceState(null, '', url);
		}

		const osQuery = matchMedia('(prefers-reduced-motion: reduce)');
		window.plankMotion = () => {
			let sim = 'follow';
			let site = false;
			try { sim = sessionStorage.getItem('proto-os') || 'follow'; } catch {}
			try { site = localStorage.getItem('plank-reduce-motion') === 'true'; } catch {}
			const os = sim === 'reduce' || (sim === 'follow' && osQuery.matches);
			const why = os ? 'os' : site ? 'site' : '';
			root.dataset.os = sim;
			root.dataset.rm = why ? 'reduce' : 'ok';
			root.dataset.rmWhy = why;
			document.dispatchEvent(new CustomEvent('proto:motion'));
		};
		osQuery.addEventListener('change', window.plankMotion);
		window.plankMotion();

		// Cross-document view transitions are declared in motion.css; only C, with motion allowed, keeps them.
		const keep = () => root.dataset.motion === 'C' && root.dataset.rm === 'ok';
		addEventListener('pageswap', (e) => { if (e.viewTransition && !keep()) e.viewTransition.skipTransition(); });
		addEventListener('pagereveal', (e) => { if (e.viewTransition && !keep()) e.viewTransition.skipTransition(); });
	})();
</script>
