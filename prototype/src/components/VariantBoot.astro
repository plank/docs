---
// PROTOTYPE: picks the variant before first paint. The URL is the source of truth; sessionStorage
// carries it across links that don't repeat ?variant=, and the URL is rewritten so it stays shareable.
---

<script is:inline>
	(() => {
		const keys = ['A', 'B', 'C'];
		const url = new URL(location.href);
		let v = (url.searchParams.get('variant') || '').toUpperCase();
		if (!keys.includes(v)) {
			try { v = sessionStorage.getItem('proto-variant') || ''; } catch {}
		}
		if (!keys.includes(v)) v = 'A';
		document.documentElement.dataset.variant = v;
		try { sessionStorage.setItem('proto-variant', v); } catch {}
		if (url.searchParams.get('variant') !== v) {
			url.searchParams.set('variant', v);
			history.replaceState(null, '', url);
		}
	})();
</script>
